{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "db:seed": "tsx src/server/db/seed.ts",
    "lint": "tsc --noEmit",
    "verify:feature-freeze": "tsx scripts/verify-feature-freeze.ts",
    "test:feature-freeze": "tsx scripts/test-feature-freeze.ts",
    "test-jobs-and-ats": "tsx scripts/test-jobs-and-ats.ts",
    "test:e2e": "tsx scripts/test-end-to-end.ts",
    "test:browser": "tsx scripts/test-browser-e2e.ts",
    "test:db-persistence": "tsx scripts/verify-real-database-persistence.ts",
    "verify-production-fail-fast": "tsx scripts/verify-production-fail-fast.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.11",
    "autoprefixer": "^10.4.21",
    "pg-gateway": "^0.3.0-beta.4",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^4.1.14"
  }
