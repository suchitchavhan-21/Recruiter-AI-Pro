# ==============================================================================
# RECRUITER AI PRO — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port (default: 3000)
PORT=3000

# Canonical Application URL (e.g. https://your-domain.com or Cloud Run URL)
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE & PERSISTENCE (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# In production, an external persistent PostgreSQL connection string is strictly required.
# e.g.: postgresql://user:password@host:5432/recruiter_ai_prod?sslmode=require
DATABASE_URL=
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Mandatory API key for Gemini LLM and dense embeddings
GEMINI_API_KEY=

# Centralized Model Identifiers (official Google GenAI models)
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_LIGHT_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-2

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# In production, both keys must be minimum 32 characters long.
# Ephemeral random keys in production are strictly prohibited.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Admin Dashboard Gate Passcode
ADMIN_PASSCODE=

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GENERAL=300
RATE_LIMIT_MAX_AUTH=30
RATE_LIMIT_MAX_AI=50

# ------------------------------------------------------------------------------
# EMAIL (SMTP - Optional, falls back to secure in-memory console delivery)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# MEDIA STORAGE (Cloudinary - Optional)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

