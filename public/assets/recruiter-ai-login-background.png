<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1400" width="1000" height="1400">
  <defs>
    <!-- Deep Space Background Gradient -->
    <radialGradient id="spaceGrad" cx="40%" cy="30%" r="80%" fx="30%" fy="20%">
      <stop offset="0%" stop-color="#0a1238"/>
      <stop offset="45%" stop-color="#04081c"/>
      <stop offset="85%" stop-color="#020410"/>
      <stop offset="100%" stop-color="#01020a"/>
    </radialGradient>

    <!-- Nebula Glow Gradients -->
    <radialGradient id="nebulaCyan" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#00f0ff" stop-opacity="0.18"/>
      <stop offset="50%" stop-color="#0055ff" stop-opacity="0.08"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>

    <radialGradient id="nebulaPurple" cx="80%" cy="25%" r="60%">
      <stop offset="0%" stop-color="#a855f7" stop-opacity="0.15"/>
      <stop offset="60%" stop-color="#4f46e5" stop-opacity="0.05"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>

    <!-- Planetary Atmosphere & Horizon -->
    <radialGradient id="planetGlowOuter" cx="50%" cy="45%" r="50%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.85"/>
      <stop offset="25%" stop-color="#0284c7" stop-opacity="0.5"/>
      <stop offset="60%" stop-color="#1e1b4b" stop-opacity="0.2"/>
      <stop offset="100%" stop-color="#020410" stop-opacity="0"/>
    </radialGradient>

    <radialGradient id="planetSphere" cx="50%" cy="10%" r="85%">
      <stop offset="0%" stop-color="#0ea5e9" stop-opacity="0.95"/>
      <stop offset="8%" stop-color="#0369a1" stop-opacity="0.9"/>
      <stop offset="25%" stop-color="#0c2340" stop-opacity="0.95"/>
      <stop offset="55%" stop-color="#030718" stop-opacity="1"/>
      <stop offset="100%" stop-color="#01030d" stop-opacity="1"/>
    </radialGradient>

    <linearGradient id="horizonRim" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.2"/>
      <stop offset="20%" stop-color="#67e8f9" stop-opacity="0.85"/>
      <stop offset="50%" stop-color="#ffffff" stop-opacity="1"/>
      <stop offset="80%" stop-color="#818cf8" stop-opacity="0.85"/>
      <stop offset="100%" stop-color="#c084fc" stop-opacity="0.2"/>
    </linearGradient>

    <!-- Perspective Grid Line Gradient -->
    <linearGradient id="gridFadeV" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.45"/>
      <stop offset="40%" stop-color="#6366f1" stop-opacity="0.25"/>
      <stop offset="85%" stop-color="#0ea5e9" stop-opacity="0.05"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </linearGradient>

    <linearGradient id="gridFadeH" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0"/>
      <stop offset="15%" stop-color="#38bdf8" stop-opacity="0.35"/>
      <stop offset="50%" stop-color="#67e8f9" stop-opacity="0.5"/>
      <stop offset="85%" stop-color="#38bdf8" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/>
    </linearGradient>

    <!-- Filters for Glow -->
    <filter id="bloomSoft" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="16" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
    
    <filter id="horizonGlowFilter" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur in="SourceGraphic" stdDeviation="12" result="blur1"/>
      <feGaussianBlur in="SourceGraphic" stdDeviation="35" result="blur2"/>
      <feMerge>
        <feMergeNode in="blur2"/>
        <feMergeNode in="blur1"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Layer 1: Background Cosmos -->
  <rect width="1000" height="1400" fill="url(#spaceGrad)"/>

  <!-- Layer 2: Nebula Blooms -->
  <ellipse cx="400" cy="500" rx="550" ry="350" fill="url(#nebulaCyan)"/>
  <ellipse cx="750" cy="300" rx="400" ry="300" fill="url(#nebulaPurple)"/>
  <ellipse cx="200" cy="800" rx="350" ry="250" fill="url(#nebulaCyan)"/>

  <!-- Layer 3: Faint Distant Starfield -->
  <g fill="#ffffff">
    <!-- Star clusters with varying opacity & size -->
    <circle cx="120" cy="150" r="1.5" opacity="0.75"/>
    <circle cx="180" cy="85" r="1" opacity="0.4"/>
    <circle cx="280" cy="190" r="1.8" opacity="0.85"/>
    <circle cx="340" cy="70" r="0.8" opacity="0.5"/>
    <circle cx="450" cy="220" r="1.4" opacity="0.6"/>
    <circle cx="580" cy="110" r="2.2" opacity="0.9"/>
    <circle cx="670" cy="170" r="1" opacity="0.35"/>
    <circle cx="790" cy="95" r="1.6" opacity="0.7"/>
    <circle cx="890" cy="140" r="1.2" opacity="0.5"/>
    <circle cx="920" cy="60" r="1.5" opacity="0.8"/>
    
    <circle cx="80" cy="380" r="1.2" opacity="0.55"/>
    <circle cx="210" cy="420" r="1.6" opacity="0.8"/>
    <circle cx="310" cy="350" r="1" opacity="0.45"/>
    <circle cx="490" cy="410" r="2" opacity="0.85"/>
    <circle cx="620" cy="390" r="1.2" opacity="0.6"/>
    <circle cx="730" cy="440" r="1.8" opacity="0.75"/>
    <circle cx="850" cy="360" r="0.9" opacity="0.4"/>
    <circle cx="940" cy="420" r="1.4" opacity="0.7"/>

    <circle cx="150" cy="580" r="1" opacity="0.45"/>
    <circle cx="260" cy="650" r="1.5" opacity="0.7"/>
    <circle cx="390" cy="590" r="1.2" opacity="0.65"/>
    <circle cx="680" cy="620" r="1.4" opacity="0.5"/>
    <circle cx="820" cy="570" r="2" opacity="0.8"/>
    <circle cx="910" cy="680" r="1.1" opacity="0.55"/>

    <circle cx="90" cy="790" r="1.4" opacity="0.6"/>
    <circle cx="220" cy="850" r="0.8" opacity="0.4"/>
    <circle cx="780" cy="780" r="1.6" opacity="0.75"/>
    <circle cx="880" cy="840" r="1.2" opacity="0.6"/>

    <!-- Subtle Twinkle Cross Flares on major stars -->
    <g transform="translate(580, 110)" opacity="0.9">
      <path d="M-8,0 L8,0 M0,-8 L0,8" stroke="#67e8f9" stroke-width="0.75" stroke-linecap="round"/>
      <circle cx="0" cy="0" r="1.8" fill="#ffffff"/>
    </g>
    <g transform="translate(280, 190)" opacity="0.85">
      <path d="M-6,0 L6,0 M0,-6 L0,6" stroke="#a5f3fc" stroke-width="0.6" stroke-linecap="round"/>
      <circle cx="0" cy="0" r="1.4" fill="#ffffff"/>
    </g>
    <g transform="translate(820, 570)" opacity="0.8">
      <path d="M-6,0 L6,0 M0,-6 L0,6" stroke="#c084fc" stroke-width="0.6" stroke-linecap="round"/>
      <circle cx="0" cy="0" r="1.5" fill="#ffffff"/>
    </g>
  </g>

  <!-- Layer 4: Glowing Planetary Sphere & Curving Horizon -->
  <g transform="translate(0, 50)">
    <!-- Outer Atmospheric Halo Behind Planet -->
    <ellipse cx="500" cy="1400" rx="750" ry="460" fill="url(#planetGlowOuter)" filter="url(#bloomSoft)" opacity="0.95"/>
    
    <!-- Planet Body (Giant Curving Sphere) -->
    <ellipse cx="500" cy="1400" rx="680" ry="400" fill="url(#planetSphere)"/>

    <!-- Planet Horizon Bright Rim -->
    <path d="M -180,1400 A 680 400 0 0,1 1180,1400" fill="none" stroke="url(#horizonRim)" stroke-width="4.5" filter="url(#horizonGlowFilter)"/>
    <path d="M -180,1400 A 680 400 0 0,1 1180,1400" fill="none" stroke="#ffffff" stroke-width="1.8" opacity="0.9"/>
    
    <!-- Secondary Atmospheric Corona -->
    <ellipse cx="500" cy="1395" rx="685" ry="404" fill="none" stroke="#38bdf8" stroke-width="8" opacity="0.4" filter="url(#bloomSoft)"/>
  </g>

  <!-- Layer 5: Futuristic Perspective Grid extending to the lower horizon -->
  <g opacity="0.75">
    <!-- Perspective Converging Vertical Grid Lines -->
    <!-- Center horizon vanishing point around (500, 1080) -->
    <line x1="500" y1="1080" x2="500" y2="1400" stroke="url(#gridFadeV)" stroke-width="1.8"/>
    <line x1="500" y1="1080" x2="400" y2="1400" stroke="url(#gridFadeV)" stroke-width="1.6"/>
    <line x1="500" y1="1080" x2="600" y2="1400" stroke="url(#gridFadeV)" stroke-width="1.6"/>
    <line x1="500" y1="1080" x2="280" y2="1400" stroke="url(#gridFadeV)" stroke-width="1.5"/>
    <line x1="500" y1="1080" x2="720" y2="1400" stroke="url(#gridFadeV)" stroke-width="1.5"/>
    <line x1="500" y1="1080" x2="140" y2="1400" stroke="url(#gridFadeV)" stroke-width="1.4"/>
    <line x1="500" y1="1080" x2="860" y2="1400" stroke="url(#gridFadeV)" stroke-width="1.4"/>
    <line x1="500" y1="1080" x2="-20" y2="1400" stroke="url(#gridFadeV)" stroke-width="1.3"/>
    <line x1="500" y1="1080" x2="1020" y2="1400" stroke="url(#gridFadeV)" stroke-width="1.3"/>
    <line x1="500" y1="1080" x2="-200" y2="1400" stroke="url(#gridFadeV)" stroke-width="1.2"/>
    <line x1="500" y1="1080" x2="1200" y2="1400" stroke="url(#gridFadeV)" stroke-width="1.2"/>

    <!-- Horizontal Floor Perspective Rings/Lines -->
    <path d="M 150,1110 Q 500,1095 850,1110" fill="none" stroke="url(#gridFadeH)" stroke-width="1.2" opacity="0.35"/>
    <path d="M 80,1140 Q 500,1120 920,1140" fill="none" stroke="url(#gridFadeH)" stroke-width="1.3" opacity="0.45"/>
    <path d="M 0,1180 Q 500,1155 1000,1180" fill="none" stroke="url(#gridFadeH)" stroke-width="1.4" opacity="0.6"/>
    <path d="M -80,1230 Q 500,1198 1080,1230" fill="none" stroke="url(#gridFadeH)" stroke-width="1.6" opacity="0.75"/>
    <path d="M -150,1290 Q 500,1250 1150,1290" fill="none" stroke="url(#gridFadeH)" stroke-width="1.8" opacity="0.9"/>
    <path d="M -200,1360 Q 500,1310 1200,1360" fill="none" stroke="url(#gridFadeH)" stroke-width="2.2" opacity="1"/>
  </g>

  <!-- Ambient Light Reflection on Top Edge of Grid -->
  <ellipse cx="500" cy="1085" rx="320" ry="12" fill="#38bdf8" opacity="0.2" filter="url(#bloomSoft)"/>
</svg>
